def compliant_approach(threshold_n=5.0, timeout_s=10.0):
            from DSR_ROBOT2 import (
                set_ref_coord, task_compliance_ctrl, release_compliance_ctrl,
                amovel, stop, STOP_TYPE_QUICK, check_motion, check_force_condition,
                get_current_posx, DR_BASE, DR_TOOL, DR_AXIS_Z, wait
            )

            self.get_logger().info(f"[APPROACH] 스르륵 하강 탐색 시작 (감지 기준: {threshold_n}N)")

            # 1. 닿을 때 충격을 스프링처럼 흡수하도록 Z축만 부드럽게(80) 켭니다.
            set_ref_coord(DR_TOOL)
            task_compliance_ctrl(stx=[3000, 3000, 80, 200, 200, 200])
            wait(0.2) 

            # 2. 하강할 목표 위치 생성 (현재 위치에서 Z축 방향으로 80mm 아래로 스르륵 내려감)
            cur, _ = get_current_posx(DR_BASE)
            # 타일이 바닥에 있으므로 Base 좌표계 기준 Z를 빼서 아래로 이동하게 만듭니다.
            target_pos = [cur[0], cur[1], 120 , cur[3], cur[4], cur[5]]

            # 3. 비동기 하강 (가장 중요 ⭐)
            # set_desired_force 대신, amovel을 써서 일정한 속도(vel=15)로 아주 우아하게 내려갑니다.
            amovel(target_pos, vel=15, acc=15, ref=DR_BASE)
            wait(0.1) # 모션이 확실히 시작되도록 아주 잠깐 대기

            is_contact = False
            
            # 4. 내려가는 동안 계속 힘을 감지
            while check_motion() != 0:
                # 툴 끝에 설정한 threshold_n 이상의 힘이 걸리는지 확인
                ret = check_force_condition(DR_AXIS_Z, min=0, max=float(threshold_n))
                
                if ret == -1:
                    self.get_logger().info(f"✅ [APPROACH] 접촉 감지! ({threshold_n}N) 하강 정지.")
                    stop(STOP_TYPE_QUICK) # 닿자마자 즉시 정지!
                    is_contact = True
                    break
                
                # 강제 정지 예외 처리
                if self._stop_soft:
                    stop(STOP_TYPE_QUICK)
                    break
                
                wait(0.01)

            # 5. 진공 흡착이 완료될 시간 벌기
            if is_contact:
                # 로봇이 멈춘 상태(살짝 눌린 상태)에서 고무판 안의 공기가 빠질 수 있도록 0.5초 대기합니다.
                wait(0.5) 

            # 6. 제어 권한 원상 복구
            release_compliance_ctrl()
            set_ref_coord(DR_BASE)
            wait(0.5)
            
